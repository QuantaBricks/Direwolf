# Stray Fortran runtime scratch output (raw unit-6/unit-8-style dumps,
# .CP/.CPC-named checkpoint scratch) that has ended up accidentally
# git-committed from a repo-root test run before - not source, not
# example data, never meant to be tracked.
fort.*
.CP
.CPC

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.lib

# Executables
*.exe
*.out
*.app
/Direwolf
/build/

# benchmark/accuracy: only systems.json + run_accuracy.py are tracked.
# Generated inputs, outputs, results and report tables are machine-
# specific - regenerate with `python3 run_accuracy.py`.
/benchmark/accuracy/Engine/
/benchmark/accuracy/Psi4/
/benchmark/accuracy/orca/
/benchmark/accuracy/.psi4_scratch/
/benchmark/accuracy/__pycache__/
/benchmark/accuracy/results.json
/benchmark/accuracy/*.md
/benchmark/accuracy/*.log

# Third-party dependency chain: source is vendored (third_party/*), the
# build OUTPUT is not - `make Engine` builds all of it automatically
# from a clean clone (see Makefile's third-party build rules).
/third_party/libcint/build/
/third_party/toml-f/build/
/third_party/mctc-lib/build/
/third_party/simple-dftd3/build/
/third_party/gcp/build/
/third_party/dftd4/build/
/third_party/multicharge/build/
/third_party/libxc/build/
/third_party/_install/
/third_party/OpenBLAS/*.a
/third_party/OpenBLAS/*.so*
/lib/libcint.a
/lib/libopenblas_pthread.a
/lib/libcint_ecp.a
referenceDir/

# Benchmark reports (Engine-vs-Psi4 comparisons) - generated locally,
# not tracked (numbers are machine/run-specific and go stale quickly).
/report/

# Session work summaries - local notes, not tracked.
/SUMMARY.md

# scripts/make_release.sh output - generated on demand, not tracked.
/release/

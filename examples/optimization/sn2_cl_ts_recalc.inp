&molecule
 runtype = 'opt'
 imult      = 1
 icharge    = -1
 functional = 'PBE0'
 baselabel  = 'def2-svp'
 J          = 'RI'
 K          = 'cosx'
 freq       = .true.     ! confirm one imaginary mode at the end
&end

&opt
 opt_ts = .true.
 opt_hess = 'calc'          ! analytic Hessian at the first step
 opt_hess_every = 3         ! and every 3 cycles (Gaussian recalc=3)
&end

&atoms
Cl 0.00000000 0.00000000 -2.20000000
C 0.00000000 0.00000000 0.00000000
Cl 0.00000000 0.00000000 2.50000000
H 1.06294437 0.10665018 0.12000000
H -0.62383395 0.86721174 0.12000000
H -0.43911043 -0.97386192 0.12000000
&end

&molecule
 runtype = 'opt'
 imult      = 1
 icharge    = 0
 functional = 'PBE'
 baselabel  = '6-31g'
 J          = 'RI'
 K          = 'RI'
&end

&atoms
O    0.0000    0.0000    0.1500
H    0.0000    0.7700   -0.4800
H    0.0000   -0.7700   -0.4800
&end

&opt
 opt_hess = 'read'          ! read a Cartesian Hessian from a file (Gaussian readfc)
 opt_hessian_file = 'examples/optimization/water_gfn2.hessian'
&end
